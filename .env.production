MODE="production"

# --- Unobravo feature gating -------------------------------------------------
# Every flag defaults to true, so leaving one unset keeps upstream behaviour —
# the gating fails open by design, which is what keeps an unconfigured build
# byte-identical to upstream. `unobravo/tests/envProduction.test.ts` asserts
# this block stays intact, because a deleted line here silently reopens a
# feature. See unobravo/config/features.ts and unobravo/FORK.md.
VITE_APP_UNOBRAVO_ENABLE_PLUS=false
VITE_APP_UNOBRAVO_ENABLE_AI=false
VITE_APP_UNOBRAVO_ENABLE_LIBRARY=false
VITE_APP_UNOBRAVO_ENABLE_SOCIALS=false
# collaboration and share links stay off until they point at Unobravo
# infrastructure — see the endpoints below, which are still Excalidraw's
VITE_APP_UNOBRAVO_ENABLE_COLLABORATION=false
VITE_APP_UNOBRAVO_ENABLE_SHARE_LINKS=false
# end users must not be able to flip the flags from the URL in production
VITE_APP_UNOBRAVO_ALLOW_FLAG_OVERRIDES=false
# -----------------------------------------------------------------------------

# The endpoints below are still Excalidraw's. Nothing reaches them: the four
# surfaces that would are gated off above. They are deliberately NOT blanked —
# an empty base URL turns `fetch(BACKEND_V2_POST)` into a same-origin POST of
# the user's scene, which is a quieter failure than an obviously foreign host.
# The flags are the gate; these are the values the gate protects.
#
# TODO(unobravo): point at the Unobravo share backend, then flip
# VITE_APP_UNOBRAVO_ENABLE_SHARE_LINKS to true.
VITE_APP_BACKEND_V2_GET_URL=https://json.excalidraw.com/api/v2/
VITE_APP_BACKEND_V2_POST_URL=https://json.excalidraw.com/api/v2/post/

VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

VITE_APP_PLUS_LP=https://plus.excalidraw.com
VITE_APP_PLUS_APP=https://app.excalidraw.com

VITE_APP_AI_BACKEND=https://oss-ai.excalidraw.com

# socket server URL used for collaboration
# TODO(unobravo): point at the Unobravo collaboration server, then flip
# VITE_APP_UNOBRAVO_ENABLE_COLLABORATION to true.
VITE_APP_WS_SERVER_URL=https://oss-collab.excalidraw.com

# TODO(unobravo): swap for the Unobravo Firebase project. Reached only through
# collaboration and shared-link images, both gated off above.
VITE_APP_FIREBASE_CONFIG='{"apiKey":"AIzaSyAd15pYlMci_xIp9ko6wkEsDzAAA0Dn0RU","authDomain":"excalidraw-room-persistence.firebaseapp.com","databaseURL":"https://excalidraw-room-persistence.firebaseio.com","projectId":"excalidraw-room-persistence","storageBucket":"excalidraw-room-persistence.appspot.com","messagingSenderId":"654800341332","appId":"1:654800341332:web:4a692de832b55bd57ce0c1"}'

VITE_APP_ENABLE_TRACKING=false

# excalidraw-app/sentry.ts keys the DSN off the hostname and treats any
# *.vercel.app host as Excalidraw staging, so without this a preview deploy of
# this fork reports its errors — including scene URLs — to Excalidraw's Sentry.
VITE_APP_DISABLE_SENTRY=true

# only read by the Excalidraw+ export bridge, which is gated off in this build
VITE_APP_PLUS_EXPORT_PUBLIC_KEY='MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEApQ0jM9Qz8TdFLzcuAZZX
/WvuKSOJxiw6AR/ZcE3eFQWM/mbFdhQgyK8eHGkKQifKzH1xUZjCxyXcxW6ZO02t
